PORT=5005
FRONTEND_URL=http://127.0.0.1:5005
ALLOW_PUBLIC_REGISTRATION=true
NODE_ENV=development
# Set to true on the public iPhone production server. This disables the
# unofficial Spotify/YouTube/Canvas and media-conversion API routes.
APP_STORE_MODE=false
SPOTIFY_MARKET=FR

# Add your own Spotify app credentials here if you want Spotify features.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5005/callback
# Cookie sp_dc du compte propriétaire. Secret serveur uniquement : ne jamais
# le mettre dans le code Swift, GitHub ou une application distribuée.
SPOTIFY_SP_DC=
# Jeton web temporaire, côté serveur seulement. L'application PC le capture
# automatiquement quand la session Spotify est ouverte.
SPOTIFY_WEB_TOKEN=

# Leave empty to let NeonWave generate a strong local secret.
JWT_SECRET=

# iPhone native authentication (optional). Secrets stay on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_REDIRECT_URI=https://your-api.example/api/ios/auth/google/callback
APPLE_CLIENT_ID=app.neonwave.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM private key, with literal \n between lines.
APPLE_PRIVATE_KEY=
# 32 random bytes encoded as 64 hex characters; encrypts Apple revocation tokens.
APPLE_TOKEN_ENCRYPTION_KEY=
